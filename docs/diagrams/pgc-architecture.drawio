<mxfile host="drawio" agent="ansible-postgres-proxmox" version="24.0.0">
  <diagram id="p1-logical" name="1 · Logical &amp; traffic flow">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1title" value="&lt;b style='font-size:18px'&gt;pgc-dev / pgc-prod — logical architecture&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Source: ansible-postgres-proxmox (inventories/*, playbooks/group_vars, roles/*/defaults + templates). Leader/replica roles are dynamic (Patroni + etcd).&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1740" height="50" as="geometry" />
        </mxCell>
        <mxCell id="z_out" value="Outside the DB subnet (traffic sources)" style="swimlane;container=1;collapsible=0;startSize=30;fontStyle=1;fontSize=13;rounded=1;arcSize=1;html=1;whiteSpace=wrap;align=left;spacingLeft=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="320" height="820" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="&lt;b&gt;Admin network 10.119.10.0/24&lt;/b&gt;&lt;br&gt;Ansible workstation · DBAs&lt;br&gt;&lt;i&gt;admin_cidrs&lt;/i&gt; → 22, 5000, 5001, 6432, 8404, ICMP" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="z_out">
          <mxGeometry x="20" y="50" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="app" value="&lt;b&gt;Application servers&lt;/b&gt;&lt;br&gt;&lt;i&gt;app_cidrs: [ ]&lt;/i&gt; — EMPTY&lt;br&gt;No app tier defined in the repo. Once set: 5000 / 5001 / 6432" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontColor=#b85450;" vertex="1" parent="z_out">
          <mxGeometry x="20" y="220" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="prom" value="&lt;b&gt;Prometheus 10.45.66.120&lt;/b&gt;&lt;br&gt;not managed here; scrape jobs generated to docs/prometheus/pgc-&amp;lt;env&amp;gt;.yml" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="z_out">
          <mxGeometry x="20" y="390" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="nodmz" value="&lt;b&gt;Not in the code:&lt;/b&gt;&lt;br&gt;Public / DMZ zone, edge reverse proxy (Nginx), ingress, application layer.&lt;br&gt;&lt;br&gt;This repo builds only the database tier. The entry point is the keepalived VIP on the internal LAN; the only network allowed in today is the admin network." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontColor=#b85450;align=left;spacing=8;" vertex="1" parent="z_out">
          <mxGeometry x="20" y="560" width="280" height="220" as="geometry" />
        </mxCell>
        <mxCell id="z_lan" value="Internal LAN 10.50.200.0/24 · gw 10.50.200.1 · Proxmox bridge vmbr0, untagged · dev AND prod share this subnet" style="swimlane;container=1;collapsible=0;startSize=30;fontStyle=1;fontSize=13;rounded=1;arcSize=1;html=1;whiteSpace=wrap;align=left;spacingLeft=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="420" y="80" width="1360" height="820" as="geometry" />
        </mxCell>
        <mxCell id="iso" value="dev ↔ prod isolation is host-level only: firewalld DROP zone 'pgc' + reject rules (ingress+egress) for the other env's IPs/VIP, pg_hba + pgbouncer_hba reject, separate etcd CA, separate VRID" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#b85450;align=left;" vertex="1" parent="z_lan">
          <mxGeometry x="20" y="34" width="1320" height="30" as="geometry" />
        </mxCell>
        <mxCell id="edev" value="pgc-dev · Patroni scope pgc-dev · nodes 10.50.200.242 / .243 / .244" style="swimlane;container=1;collapsible=0;startSize=30;fontStyle=1;fontSize=13;rounded=1;arcSize=1;html=1;whiteSpace=wrap;align=left;spacingLeft=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="z_lan">
          <mxGeometry x="20" y="70" width="640" height="730" as="geometry" />
        </mxCell>
        <mxCell id="edevvip" value="&lt;b&gt;Tier 1 · Entry — VIP 10.50.200.245/24&lt;/b&gt;&lt;br&gt;keepalived 2.2.8 · unicast VRRP · VRID 242 · all BACKUP + nopreempt" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="edev">
          <mxGeometry x="20" y="40" width="600" height="60" as="geometry" />
        </mxCell>
        <mxCell id="edevhap" value="&lt;b&gt;Tier 2 · Routing — HAProxy 3.0.5 ×3&lt;/b&gt; (serves on the VIP holder)&lt;br&gt;:5000 → primary (RW, check GET /primary) · :5001 → replicas (RO, roundrobin, GET /replica?lag=16MB) · :8404 stats" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="edev">
          <mxGeometry x="20" y="140" width="600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="edevpgb" value="&lt;b&gt;Tier 3 · Pooling — PgBouncer 1.26.0 ×3 :6432&lt;/b&gt;&lt;br&gt;pool_mode=transaction · max_client_conn 1000 · pool 20 + 5 reserve · max_db_conn 150 · auth_query + SCRAM" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="edev">
          <mxGeometry x="20" y="250" width="600" height="70" as="geometry" />
