        </mxCell>
        <mxCell id="lr" value="&lt;b&gt;listen replicas :5001&lt;/b&gt;&lt;br&gt;roundrobin · GET /replica?lag=16MB" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#3b6db3;strokeWidth=2;" vertex="1" parent="hap">
