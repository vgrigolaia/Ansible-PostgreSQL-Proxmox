# Prometheus scrape config for {{ cluster_name }} ({{ pgc_env }}).
# Generated by `site.yml --tags monitoring`; do not edit by hand.
# Add these jobs under `scrape_configs:` on the Prometheus server {{ prometheus_server_ip }}.
# The nodes' firewalls accept these ports from {{ prometheus_server_ip }} only.
---
{% for job, spec in prometheus_targets_jobs.items() %}
- job_name: {{ cluster_name }}-{{ job }}
  metrics_path: {{ spec[1] }}
  static_configs:
{% for h in groups['pg_nodes'] %}
    - targets: ["{{ hostvars[h].ansible_host }}:{{ spec[0] }}"]
      labels:
        env: {{ pgc_env }}
        cluster: {{ cluster_name }}
        node: {{ h }}
{% endfor %}
{% endfor %}
